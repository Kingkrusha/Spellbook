{
 "random_tables": [
  {
   "name": "Weather",
   "category": "Travel",
   "dice": "d20",
   "description": "The day's weather on the road. Roll each morning, or when the party makes camp.",
   "entries": [
    {
     "low": 1,
     "high": 6,
     "text": "Clear skies and a light breeze."
    },
    {
     "low": 7,
     "high": 10,
     "text": "Overcast; the light is flat and grey all day."
    },
    {
     "low": 11,
     "high": 13,
     "text": "Light rain from midday. Tracks are easy to follow."
    },
    {
     "low": 14,
     "high": 15,
     "text": "Thick morning fog: visibility 30 feet until noon."
    },
    {
     "low": 16,
     "high": 17,
     "text": "Strong winds. Ranged attacks have disadvantage beyond normal range; flying is hard work."
    },
    {
     "low": 18,
     "high": 19,
     "text": "Heavy rain all day. Travel pace is slowed and fires are hard to light."
    },
    {
     "low": 20,
     "high": 20,
     "text": "A storm: thunder, lightning and driving rain. Seek shelter or risk exhaustion."
    }
   ],
   "tags": [
    "Travel",
    "Weather"
   ],
   "source": "Spellbook"
  },
  {
   "name": "Road Encounters",
   "category": "Travel",
   "dice": "d100",
   "description": "Who or what the party meets on a well-travelled road.",
   "entries": [
    {
     "low": 1,
     "high": 10,
     "text": "A merchant with {1d4} pack mules, eager to trade."
    },
    {
     "low": 11,
     "high": 20,
     "text": "{2d4} pilgrims walking to a distant shrine."
    },
    {
     "low": 21,
     "high": 30,
     "text": "A patrol of {1d6+1} guards asks the party their business."
    },
    {
     "low": 31,
     "high": 40,
     "text": "A broken-down wagon blocks the road; its driver begs for help."
    },
    {
     "low": 41,
     "high": 50,
     "text": "A traveling performer offers a song for a coin."
    },
    {
     "low": 51,
     "high": 60,
     "text": "Fresh tracks lead off the road into the trees."
    },
    {
     "low": 61,
     "high": 70,
     "text": "{1d4+2} bandits demand a toll."
    },
    {
     "low": 71,
     "high": 78,
     "text": "A lost child who says their village is \"just over the hill\"."
    },
    {
     "low": 79,
     "high": 86,
     "text": "A hungry beast stalks the party from a distance."
    },
    {
     "low": 87,
     "high": 93,
     "text": "A messenger on horseback gallops past without stopping, dropping a sealed letter."
    },
    {
     "low": 94,
     "high": 98,
     "text": "An abandoned camp, its fire still warm."
    },
    {
     "low": 99,
     "high": 100,
     "text": "Something strange. {table: Plot Twists}"
    }
   ],
   "tags": [
    "Travel",
    "Encounter"
   ],
   "source": "Spellbook"
  },
  {
   "name": "Plot Twists",
   "category": "Story",
   "dice": "d12",
   "description": "When the story needs a jolt.",
   "entries": [
    {
     "low": 1,
     "high": 1,
     "text": "A trusted ally has been working for the enemy all along."
    },
    {
     "low": 2,
     "high": 2,
     "text": "The quest giver lied about the reward."
    },
    {
     "low": 3,
     "high": 3,
     "text": "The villain's plan is already complete; the party must deal with the result."
    },
    {
     "low": 4,
     "high": 4,
     "text": "Someone the party thought dead returns."
    },
    {
     "low": 5,
     "high": 5,
     "text": "The treasure everyone is chasing is a fake."
    },
    {
     "low": 6,
     "high": 6,
     "text": "Two of the party's enemies turn on each other."
    },
    {
     "low": 7,
     "high": 7,
     "text": "The weather turns, cutting the party off from help."
    },
    {
     "low": 8,
     "high": 8,
     "text": "A rival group of adventurers gets there first."
    },
    {
     "low": 9,
     "high": 9,
     "text": "The monster is protecting something, not attacking."
    },
    {
     "low": 10,
     "high": 10,
     "text": "An old debt of one of the characters is called in."
    },
    {
     "low": 11,
     "high": 11,
     "text": "The map is wrong."
    },
    {
     "low": 12,
     "high": 12,
     "text": "The party is offered exactly what they want, at a price."
    }
   ],
   "tags": [
    "Story"
   ],
   "source": "Spellbook"
  },
