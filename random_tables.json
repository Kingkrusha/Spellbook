  {
   "name": "NPC Quirks",
   "category": "People",
   "dice": "d20",
   "description": "Something memorable about a character the party meets.",
   "entries": [
    {
     "low": 1,
     "high": 1,
     "text": "Hums constantly, always the same tune."
    },
    {
     "low": 2,
     "high": 2,
     "text": "Never makes eye contact."
    },
    {
     "low": 3,
     "high": 3,
     "text": "Speaks in a whisper, even when angry."
    },
    {
     "low": 4,
     "high": 4,
     "text": "Collects buttons and asks for any the party has."
    },
    {
     "low": 5,
     "high": 5,
     "text": "Laughs at their own jokes before finishing them."
    },
    {
     "low": 6,
     "high": 6,
     "text": "Is terrified of cats."
    },
    {
     "low": 7,
     "high": 7,
     "text": "Quotes a famous poet, badly."
    },
    {
     "low": 8,
     "high": 8,
     "text": "Chews on a twig."
    },
    {
     "low": 9,
     "high": 9,
     "text": "Calls everyone \"friend\", including enemies."
    },
    {
     "low": 10,
     "high": 10,
     "text": "Insists on haggling over everything."
    },
    {
     "low": 11,
     "high": 11,
     "text": "Has a pet rat on their shoulder."
    },
    {
     "low": 12,
     "high": 12,
     "text": "Tells long stories about a cousin who is clearly made up."
    },
    {
     "low": 13,
     "high": 13,
     "text": "Writes everything down in a tiny notebook."
    },
    {
     "low": 14,
     "high": 14,
     "text": "Is extremely polite and formal."
    },
    {
     "low": 15,
     "high": 15,
     "text": "Can't stand still."
    },
    {
     "low": 16,
     "high": 16,
     "text": "Distrusts anyone carrying a weapon."
    },
    {
     "low": 17,
     "high": 17,
     "text": "Gives everyone a nickname."
    },
    {
     "low": 18,
     "high": 18,
     "text": "Speaks to the gods out loud."
    },
    {
     "low": 19,
     "high": 19,
     "text": "Has an outrageous hat and is proud of it."
    },
    {
     "low": 20,
     "high": 20,
     "text": "Knows everyone's business in town."
    }
   ],
